// ประเภทสินทรัพย์ถาวร
enum FixedAssetCategory {
  LAND              // ที่ดิน
  BUILDING          // อาคาร
  BUILDING_IMPROVE  // ส่วนปรับปรุงอาคาร
  FURNITURE         // เฟอร์นิเจอร์และของตกแต่ง
