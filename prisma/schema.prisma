  @@index([merchantOrderId])
  @@map("truemoney_transactions")
}
// =============================================================================
// HOTEL ACCOUNTING SYSTEM — Prisma Schema
// =============================================================================
// วิธีใช้: append ทั้งไฟล์นี้ต่อท้าย prisma/schema.prisma หลัก
// แล้วรัน: npx prisma migrate dev --name add_accounting_system
// =============================================================================
//
// MODULE OVERVIEW:
//   1. accounting-core   — ผังบัญชี, สมุดรายวัน, บัญชีแยกประเภท, ปีบัญชี
//   2. accounts-receivable — ลูกหนี้, Guest Folio, ใบเสร็จรับเงิน
//   3. accounts-payable  — เจ้าหนี้, Supplier Invoice, การจ่ายชำระ
//   4. tax-management    — VAT, WHT, ใบหัก ณ ที่จ่าย, การยื่นแบบ (Thai standard)
//   5. night-audit       — Night Audit, Auto posting
//   6. cash-management   — เงินสด, กระทบยอดธนาคาร
//   7. fixed-assets      — สินทรัพย์ถาวร, ค่าเสื่อมราคา
// =============================================================================

// ─── ENUMS ─────────────────────────────────────────────────────────────────────

// ประเภทบัญชีหลัก (5 หมวด)
enum AccountType {
  ASSET       // สินทรัพย์
