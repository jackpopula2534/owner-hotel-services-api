generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x", "linux-arm64-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                     @id @default(uuid())
  email                   String                     @unique
  password                String
  firstName               String?
  lastName                String?
  role                    String                     @default("user")
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  authProvider            String                     @default("local")
  employeeId              String?
  language                String?
  lastLoginAt             DateTime?
  lastLoginIp             String?
  metadata                String?                    @db.Text
  phone                   String?
  status                  String                     @default("active") @db.VarChar(20)
  tenantId                String?
  timezone                String?
  allowedSystems          String                     @default("[\"main\"]") @db.VarChar(255)
  approvalLimit           Decimal?                   @db.Decimal(12, 2)
  procurementPermissions  String?                    @db.Text
  warehousePermissions    String?                    @db.Text
  warehouseIds            String?                    @db.Text
  expiresAt               DateTime?
  suspendedAt             DateTime?
  suspendedBy             String?                    @db.VarChar(36)
  suspendedReason         String?                    @db.Text
  deactivatedAt           DateTime?
  approvalStepAssignments ApprovalFlowStepApprover[]
  notifications           Notification[]
  refreshTokens           RefreshToken[]
  userTenants             UserTenant[]

  @@map("users")
}

model Admin {
  id            String         @id @default(uuid()) @db.VarChar(36)
  firstName     String?
  lastName      String?
  email         String         @unique(map: "IDX_051db7d37d478a69a7432df147")
  password      String
  role          String         @default("platform_admin")
  status        String         @default("active")
  lastLoginAt   DateTime?      @db.DateTime(0)
  lastLoginIp   String?
  createdAt     DateTime       @default(now()) @db.DateTime(6)
  updatedAt     DateTime       @default(now()) @updatedAt @db.DateTime(6)
  refreshTokens RefreshToken[]

  @@map("admins")
}

model RefreshToken {
  id            String    @id @default(uuid()) @db.VarChar(36)
  token         String    @unique
  userId        String?   @db.VarChar(36)
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?
  adminId       String?   @db.VarChar(36)
  deviceName    String?   @db.VarChar(255)
  deviceType    String?   @db.VarChar(50)
  ipAddress     String?   @db.VarChar(45)
  userAgent     String?   @db.Text
  lastUsedAt    DateTime?
  lastUsedIp    String?   @db.VarChar(45)
  systemContext String    @default("main") @db.VarChar(20)
  admin         Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([adminId])
  @@index([userId, lastUsedAt])
  @@index([userId, systemContext])
  @@map("refresh_tokens")
}

model password_resets {
  id        String   @id @default(uuid()) @db.VarChar(36)
  email     String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([email])
  @@map("password_resets")
}

model Guest {
  id                 String    @id @default(uuid())
  tenantId           String?
  firstName          String
  lastName           String
  email              String?
  phone              String?
  nationalId         String?
  passportNumber     String?
  dateOfBirth        String?
  nationality        String?
  address            String?
  city               String?
  country            String?
  postalCode         String?
  isVip              Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  vehiclePlateNumber String?
  vipLevel           String?
  specialNotes       String?   @db.Text
  // ── PDPA Consent (S1-02) ──────────────────────────────────
  consentGiven       Boolean   @default(false)
  consentAt          DateTime?
  consentVersion     String?   @db.VarChar(20)
  consentIpAddress   String?   @db.VarChar(45)
  // ── Right to Erasure (S2-02) ─────────────────────────────
  anonymizedAt       DateTime?
  bookings           Booking[]
  arInvoices         ArInvoice[]
  arReceipts         ArReceipt[]
  guestFolios        GuestFolio[]
  conversations      Conversation[]

  @@index([tenantId])
  @@map("guests")
}

model Property {
  id                    String            @id @default(uuid())
  tenantId              String
  name                  String
  code                  String
  location              String?
  description           String?           @db.Text
  phone                 String?
  email                 String?
  isDefault             Boolean           @default(false)
  status                String            @default("active")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  deletedAt             DateTime?         @map("deleted_at")
  serviceChargeEnabled  Boolean           @default(true)
  serviceChargePercent  Float             @default(10)
  vatEnabled            Boolean           @default(true)
  vatPercent            Float             @default(7)
  taxDisplayMode        String            @default("breakdown")
  standardCheckInTime   String            @default("14:00")
  standardCheckOutTime  String            @default("12:00")
  cleaningBufferMinutes Int               @default(60)
  earlyCheckInEnabled   Boolean           @default(false)
  lateCheckOutEnabled   Boolean           @default(false)
  earlyCheckInFeeType   String?           @default("fixed")
  earlyCheckInFeeAmount Decimal?          @db.Decimal(10, 2)
  lateCheckOutFeeType   String?           @default("fixed")
  lateCheckOutFeeAmount Decimal?          @db.Decimal(10, 2)
  timezone              String            @default("Asia/Bangkok")
  bookings              Booking[]
  employees             Employee[]
  maintenanceTasks      MaintenanceTask[]
  paymentAccounts       PaymentAccount[]
  paymentSettings       PaymentSettings?
  restaurants           Restaurant[]
  rooms                 Room[]
  warehouses            Warehouse[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([deletedAt])
  @@map("properties")
}

model PaymentSettings {
  id                   String   @id @default(uuid())
  propertyId           String   @unique
  /// เปิดรับชำระผ่าน PromptPay
  promptpayEnabled     Boolean  @default(false)
  /// (Legacy/Default) หมายเลข PromptPay เบอร์โทร หรือ เลขบัตรประชาชน — ใช้เป็น fallback เมื่อไม่มี PaymentAccount
  promptpayId          String?  @db.VarChar(20)
  /// (Legacy/Default) ชื่อบัญชี PromptPay
  promptpayAccountName String?  @db.VarChar(200)
  /// เปิดรับโอนผ่านบัญชีธนาคาร
  bankTransferEnabled  Boolean  @default(false)
  /// เปิดรับเงินสด
  cashEnabled          Boolean  @default(true)
  /// คำแนะนำการชำระเงินสด
  cashInstructions     String?  @db.VarChar(500)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  property             Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("payment_settings")
}

/// Multi-account payment configuration per property
/// kind = "promptpay" → ใช้ promptpayId / accountName
/// kind = "bank"      → ใช้ bankCode / accountNumber / accountName / branch
model PaymentAccount {
  id            String   @id @default(uuid())
  propertyId    String
  /// Channel kind: 'promptpay' | 'bank'
  kind          String   @db.VarChar(20)
  /// Display label (optional)
  label         String?  @db.VarChar(120)
  /// PromptPay-specific: เบอร์โทร / เลข ปชช.
  promptpayId   String?  @db.VarChar(20)
  /// Bank-specific: bank short code (e.g. KBANK, SCB)
  bankCode      String?  @db.VarChar(16)
  /// Bank account number
  accountNumber String?  @db.VarChar(20)
  /// Account holder name (ใช้ทั้ง promptpay และ bank)
  accountName   String?  @db.VarChar(200)
  /// Bank branch (ไม่บังคับ)
  branch        String?  @db.VarChar(120)
  /// บัญชีหลัก (default per kind) — มีได้แค่ 1 ต่อ kind ต่อ property
  isDefault     Boolean  @default(false)
  /// ใช้งานหรือไม่
  isActive      Boolean  @default(true)
  /// ลำดับการแสดงผล
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([propertyId, kind])
  @@map("payment_accounts")
}

model Room {
  id                     String             @id @default(uuid())
  tenantId               String?
  propertyId             String
  number                 String
  type                   String
  floor                  Int?
  price                  Decimal            @db.Decimal(10, 2)
  status                 String             @default("available")
  maxOccupancy           Int?               @default(2)
  bedType                String?
  size                   Int?
  amenities              Json?
  extraBedAllowed        Boolean            @default(false)
  extraBedLimit          Int                @default(0)
  extraBedPrice          Decimal            @default(0.00) @db.Decimal(10, 2)
  description            String?
  images                 Json?
  weekendPrice           Decimal?           @db.Decimal(10, 2)
  holidayPriceEnabled    Boolean            @default(false)
  holidayPriceType       String?
  holidayPrice           Decimal?           @db.Decimal(10, 2)
  holidayPricePercent    Float?
  seasonalRates          Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  childNoExtraCharge     Boolean            @default(false)
  childNoExtraChargeNote String?            @db.Text
  bookings               Booking[]
  housekeepingTasks      HousekeepingTask[]
  maintenanceTasks       MaintenanceTask[]
  property               Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, number])
  @@index([tenantId])
  @@index([propertyId])
  @@map("rooms")
}

model Booking {
  id                    String             @id @default(uuid())
  tenantId              String?
  propertyId            String
  /// เลขที่การจอง
  bookingNo             String?            @db.VarChar(30)
  guestId               String?
  roomId                String
  guestFirstName        String
  guestLastName         String
  guestEmail            String?
  guestPhone            String?
  checkIn               DateTime
  checkOut              DateTime
  scheduledCheckIn      DateTime?
  scheduledCheckOut     DateTime?
  actualCheckIn         DateTime?
  actualCheckOut        DateTime?
  requestedEarlyCheckIn Boolean?           @default(false)
  approvedEarlyCheckIn  Boolean?           @default(false)
  earlyCheckInFee       Decimal?           @db.Decimal(10, 2)
  requestedLateCheckOut Boolean?           @default(false)
  approvedLateCheckOut  Boolean?           @default(false)
  lateCheckOutFee       Decimal?           @db.Decimal(10, 2)
  status                String             @default("pending")
  totalPrice            Decimal            @db.Decimal(10, 2)
  notes                 String?
  paymentMethod         String?
  paymentStatus         String?            @default("pending")
  amountPaid            Decimal?           @db.Decimal(10, 2)
  paymentNote           String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  channelId             String?
  adults                Int?               @default(1)
  children              Int?               @default(0)
  numberOfGuests        Int?               @default(1)
  roomSubtotal          Decimal?           @db.Decimal(10, 2)
  serviceChargeAmount   Decimal?           @db.Decimal(10, 2)
  vatAmount             Decimal?           @db.Decimal(10, 2)
  grandTotal            Decimal?           @db.Decimal(10, 2)
  pricingBreakdown      Json?
  baseCapacity          Int?               @default(2)
  extraBedCapacity      Int?               @default(0)
  totalCapacity         Int?               @default(2)
  extraBedGuests        Int?               @default(0)
  standardBedGuests     Int?               @default(1)
  source                String?
  addOns                BookingAddOn[]
  arInvoices            ArInvoice[]
  guestFolios           GuestFolio[]
  channel               Channel?           @relation(fields: [channelId], references: [id])
  guest                 Guest?             @relation(fields: [guestId], references: [id])
  property              Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room                  Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  housekeepingTasks     HousekeepingTask[]
  review                Review?

  @@index([tenantId])
  @@index([propertyId])
  @@index([channelId], map: "bookings_channelId_fkey")
  @@index([guestId], map: "bookings_guestId_fkey")
  @@index([roomId], map: "bookings_roomId_fkey")
  @@index([scheduledCheckIn])
  @@index([scheduledCheckOut])
  @@index([status])
  @@map("bookings")
}

model Review {
  id        String   @id @default(uuid())
  tenantId  String?
  bookingId String?  @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("reviews")
}

model Restaurant {
  id             String            @id @default(uuid())
  tenantId       String?
  name           String
  code           String            @unique
  description    String?
  location       String?
  capacity       Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  type           RestaurantType    @default(CASUAL)
  openTime       String?
  closeTime      String?
  isActive       Boolean           @default(true)
  layoutData     Json?
  propertyId     String?
  menuCategories MenuCategory[]
  orders         Order[]
  tables         RestaurantTable[]
  property       Property?         @relation(fields: [propertyId], references: [id])
  staffCalls     StaffCall[]

  @@index([tenantId])
  @@index([propertyId])
  @@map("restaurants")
}

model RestaurantTable {
  id           String             @id @default(uuid())
  tenantId     String?
  restaurantId String
  tableNumber  String
  capacity     Int
  shape        TableShape         @default(RECTANGLE)
  status       TableStatus        @default(AVAILABLE)
  positionX    Float?
  positionY    Float?
  width        Float?
  height       Float?
  rotation     Float?             @default(0)
  zone         String?
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  orders       Order[]
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  staffCalls   StaffCall[]
  reservations TableReservation[]

  @@unique([restaurantId, tableNumber])
  @@index([tenantId])
  @@index([restaurantId])
  @@index([status])
  @@map("restaurant_tables")
}

model TableReservation {
  id              String            @id @default(uuid())
  tenantId        String?
  restaurantId    String
  tableId         String
  guestName       String
  guestPhone      String?
  guestEmail      String?
  partySize       Int
  reservationDate DateTime          @db.Date
  startTime       String
  endTime         String?
  status          ReservationStatus @default(PENDING)
  specialRequests String?
  notes           String?           @db.Text
  confirmedAt     DateTime?
  seatedAt        DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  table           RestaurantTable   @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([restaurantId])
  @@index([tableId])
  @@index([reservationDate])
  @@index([status])
  @@map("table_reservations")
}

model MenuCategory {
  id           String     @id @default(uuid())
  tenantId     String?
  restaurantId String
  name         String
  description  String?
  image        String?    @db.LongText
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  icon         String?
  color        String?
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        MenuItem[]

  @@index([tenantId])
  @@index([restaurantId])
  @@map("menu_categories")
}

model MenuItem {
  id              String          @id @default(uuid())
  tenantId        String?
  restaurantId    String
  categoryId      String
  name            String
  description     String?         @db.Text
  price           Decimal         @db.Decimal(10, 2)
  cost            Decimal?        @db.Decimal(10, 2)
  image           String?         @db.LongText
  preparationTime Int?
  calories        Int?
  allergens       Json?
  isVegetarian    Boolean         @default(false)
  isVegan         Boolean         @default(false)
  isGlutenFree    Boolean         @default(false)
  isSpicy         Boolean         @default(false)
  spicyLevel      Int?
  isAvailable     Boolean         @default(true)
  displayOrder    Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  recipe          MenuItemRecipe?
  category        MenuCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]

  @@index([tenantId])
  @@index([restaurantId])
  @@index([categoryId])
  @@index([isAvailable])
  @@map("menu_items")
}

model MenuItemRecipe {
  id           String             @id @default(uuid())
  menuItemId   String             @unique
  servings     Int?
  instructions String?            @db.Text
  notes        String?            @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  menuItem     MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredients  RecipeIngredient[]

  @@map("menu_item_recipes")
}

model RecipeIngredient {
  id           String         @id @default(uuid())
  recipeId     String
  name         String
  quantity     Decimal?       @db.Decimal(10, 3)
  unit         String?
  notes        String?
  displayOrder Int            @default(0)
  recipe       MenuItemRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@map("recipe_ingredients")
}

model Order {
  id            String             @id @default(uuid())
  tenantId      String?
  restaurantId  String
  tableId       String?
  orderNumber   String             @unique
  orderType     OrderType          @default(DINE_IN)
  status        OrderStatus        @default(PENDING)
  waiterId      String?
  guestName     String?
  guestRoom     String?
  partySize     Int?
  subtotal      Decimal            @default(0.00) @db.Decimal(10, 2)
  taxRate       Decimal            @default(7.00) @db.Decimal(5, 2)
  taxAmount     Decimal            @default(0.00) @db.Decimal(10, 2)
  serviceRate   Decimal            @default(10.00) @db.Decimal(5, 2)
  serviceCharge Decimal            @default(0.00) @db.Decimal(10, 2)
  discount      Decimal            @default(0.00) @db.Decimal(10, 2)
  total         Decimal            @default(0.00) @db.Decimal(10, 2)
  paymentStatus OrderPaymentStatus @default(UNPAID)
  paymentMethod String?
  paidAmount    Decimal?           @db.Decimal(10, 2)
  changeAmount  Decimal?           @db.Decimal(10, 2)
  notes         String?            @db.Text
  confirmedAt   DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  kitchenOrders KitchenOrder[]
  items         OrderItem[]
  restaurant    Restaurant         @relation(fields: [restaurantId], references: [id])
  table         RestaurantTable?   @relation(fields: [tableId], references: [id])

  @@index([tenantId])
  @@index([restaurantId])
  @@index([tableId])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id            String          @id @default(uuid())
  tenantId      String?
  orderId       String
  menuItemId    String
  quantity      Int
  unitPrice     Decimal         @db.Decimal(10, 2)
  totalPrice    Decimal         @db.Decimal(10, 2)
  status        OrderItemStatus @default(PENDING)
  notes         String?
  modifiers     Json?
  sentToKitchen Boolean         @default(false)
  sentAt        DateTime?
  preparedAt    DateTime?
  servedAt      DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  menuItem      MenuItem        @relation(fields: [menuItemId], references: [id])
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([menuItemId])
  @@index([status])
  @@map("order_items")
}

model KitchenOrder {
  id          String          @id @default(uuid())
  tenantId    String?
  orderId     String
  priority    KitchenPriority @default(NORMAL)
  status      OrderItemStatus @default(PENDING)
  stationName String?
  notes       String?         @db.Text
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([orderId])
  @@index([status])
  @@index([priority])
  @@map("kitchen_orders")
}

model Employee {
  id                String           @id @default(uuid())
  tenantId          String?
  firstName         String
  lastName          String
  email             String
  employeeCode      String?
  department        String?
  position          String?
  startDate         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  departmentId      String?
  positionId        String?
  bankAccount       String?
  baseSalary        Decimal?         @db.Decimal(12, 2)
  phone             String?
  status            String           @default("ACTIVE")
  allowance         Decimal?         @db.Decimal(12, 2)
  educations        Json?
  emergencyContacts Json?
  overtime          Decimal?         @db.Decimal(12, 2)
  positionBonus     Decimal?         @db.Decimal(12, 2)
  propertyId        String?
  socialSecurity    String?
  taxId             String?
  workExperiences   Json?
  nickname          String?
  dateOfBirth       DateTime?
  nationalId        String?
  gender            String?
  employmentType    String?          @default("FULLTIME")
  bankName          String?
  notes             String?          @db.Text
  initialSalary     Decimal?         @db.Decimal(12, 2)
  // ── PDPA Consent (S1-03) ──────────────────────────────────
  consentGiven      Boolean          @default(false)
  consentAt         DateTime?
  consentVersion    String?          @db.VarChar(20)
  consentIpAddress  String?          @db.VarChar(45)
  // ── Right to Erasure (S2-02) ─────────────────────────────
  anonymizedAt      DateTime?
  hrDepartment      HrDepartment?    @relation(fields: [departmentId], references: [id])
  hrPosition        HrPosition?      @relation(fields: [positionId], references: [id])
  property          Property?        @relation(fields: [propertyId], references: [id])
  attendances       HrAttendance[]
  leaveRequests     HrLeaveRequest[]
  payrolls          HrPayroll[]
  performances      HrPerformance[]
  staff             Staff?           @relation("StaffEmployee")

  @@unique([tenantId, propertyId, employeeCode])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([propertyId])
  @@index([departmentId])
  @@index([positionId])
  @@index([employeeCode])
  @@map("employees")
}

model HrDepartment {
  id          String       @id @default(uuid())
  tenantId    String
  name        String
  nameEn      String?
  code        String
  description String?      @db.Text
  color       String?
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  employees   Employee[]
  positions   HrPosition[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("hr_departments")
}

model HrPosition {
  id           String       @id @default(uuid())
  tenantId     String
  departmentId String
  name         String
  nameEn       String?
  code         String?
  level        Int          @default(1)
  description  String?      @db.Text
  isActive     Boolean      @default(true)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  employees    Employee[]
  department   HrDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([departmentId])
  @@map("hr_positions")
}

model HrLeaveType {
  id             String           @id @default(uuid())
  tenantId       String
  name           String
  nameEn         String?
  code           String
  maxDaysPerYear Int?
  isPaid         Boolean          @default(true)
