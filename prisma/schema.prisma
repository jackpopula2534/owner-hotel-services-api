// ประเภทแบบภาษี
enum TaxFilingType {
  VAT_PP30     // ภ.พ.30 (ภาษีมูลค่าเพิ่มรายเดือน)
  WHT_PND1     // ภ.ง.ด.1 (หัก ณ ที่จ่าย พนักงาน)
