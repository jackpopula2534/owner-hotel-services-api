  NO_DEPRECIATION    // ไม่คิดค่าเสื่อม (เช่น ที่ดิน)
}

// สถานะสินทรัพย์
enum AssetStatus {
  ACTIVE        // ใช้งานอยู่
  IDLE          // ไม่ได้ใช้งาน
  UNDER_REPAIR  // อยู่ระหว่างซ่อม
  DISPOSED      // จำหน่ายแล้ว
  WRITTEN_OFF   // ตัดจำหน่ายแล้ว
}

// ─── MODULE 1: ACCOUNTING CORE ────────────────────────────────────────────────
// ผังบัญชี, ปีบัญชี, สมุดรายวัน, บัญชีแยกประเภท

/// ปีบัญชี (Fiscal Year)
/// กำหนดช่วงเวลาของรอบบัญชีแต่ละปี
model FiscalYear {
  id          String         @id @default(uuid())
  tenantId    String
  propertyId  String
  /// ปี เช่น 2024, 2025
  year        Int
  /// วันเริ่มต้นปีบัญชี
  startDate   DateTime       @db.Date
  /// วันสิ้นสุดปีบัญชี
  endDate     DateTime       @db.Date
  /// สถานะ: OPEN, CLOSED, LOCKED
  status      String         @default("OPEN") @db.VarChar(20)
  /// ปิดบัญชีโดย
  closedBy    String?
  closedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  journalEntries JournalEntry[]
  periodBalances LedgerBalance[]

  @@unique([tenantId, propertyId, year])
  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
  @@map("fiscal_years")
}

/// ผังบัญชี (Chart of Accounts)
/// ใช้ 4-digit code มาตรฐาน:
///   1xxx = สินทรัพย์, 2xxx = หนี้สิน, 3xxx = ทุน
///   4xxx = รายได้, 5xxx = ต้นทุน, 6xxx = ค่าใช้จ่าย
model AccountChart {
  id              String        @id @default(uuid())
  tenantId        String
  /// รหัสบัญชี เช่น "1101", "4101"
  code            String        @db.VarChar(20)
  /// ชื่อบัญชี (ภาษาไทย)
  name            String        @db.VarChar(200)
  /// ชื่อบัญชี (ภาษาอังกฤษ)
  nameEn          String?       @db.VarChar(200)
  /// ประเภทบัญชีหลัก
  type            AccountType
  /// ประเภทย่อย เช่น "current_asset", "fixed_asset", "current_liability"
  subType         String?       @db.VarChar(50)
  /// ด้านปกติของบัญชี
  normalBalance   NormalBalance
  /// ระดับผังบัญชี
  level           AccountLevel  @default(ACCOUNT)
  /// บัญชีแม่ (สำหรับ hierarchy)
  parentId        String?
  /// บัญชีควบคุม (Accounts ใน sub-ledger เช่น AR, AP)
  isControl       Boolean       @default(false)
  /// ใช้งานอยู่
  isActive        Boolean       @default(true)
  /// ห้ามบันทึกรายการโดยตรง (เป็นแค่ category/group)
  isHeaderOnly    Boolean       @default(false)
  /// รหัสงบการเงิน สำหรับ mapping งบดุล/งบกำไรขาดทุน
  fsCode          String?       @db.VarChar(20)
  /// หมายเหตุ
  description     String?       @db.Text
  /// เชื่อมกับ CostCenter (optional)
  costCenterId    String?
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  parent          AccountChart?  @relation("AccountTree", fields: [parentId], references: [id])
  children        AccountChart[] @relation("AccountTree")
  journalLines    JournalLine[]
  ledgerBalances  LedgerBalance[]
  arInvoiceLines  ArInvoiceLine[]
  apInvoiceLines  ApInvoiceLine[]
  taxRates        TaxRate[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
  @@index([parentId])
  @@index([isActive])
  @@map("account_charts")
}

/// สมุดรายวัน (Journal Entry)
/// ทุกรายการบัญชีต้องผ่านที่นี่ — double-entry เสมอ (debit = credit)
model JournalEntry {
  id           String             @id @default(uuid())
  tenantId     String
  propertyId   String
  /// เลขที่เอกสาร เช่น "JE-2024-001234" (auto จาก DocumentSequence)
  entryNo      String             @db.VarChar(30)
  /// วันที่บันทึกรายการ
  entryDate    DateTime           @db.Date
  /// คำอธิบายรายการ
  description  String             @db.VarChar(500)
  /// อ้างอิงเอกสารต้นทาง
  reference    String?            @db.VarChar(100)
  /// แหล่งที่มา
  sourceType   JournalSourceType  @default(MANUAL)
  /// ID ของ source document (bookingId, arInvoiceId ฯลฯ)
  sourceId     String?
  /// สถานะ
  status       JournalEntryStatus @default(DRAFT)
  /// ปีบัญชี
  fiscalYearId String?
  /// งวดบัญชี (1-12)
  fiscalPeriod Int
  /// ปี
  fiscalYear   Int
  /// รวม Debit (ต้องเท่ากับ Credit เสมอ)
  totalDebit   Decimal            @default(0.00) @db.Decimal(14, 2)
  /// รวม Credit
  totalCredit  Decimal            @default(0.00) @db.Decimal(14, 2)
  /// อนุมัติโดย
  postedBy     String?
  postedAt     DateTime?
  /// Journal ที่กลับรายการ (ถ้ามี)
  reversedById String?
  reversedAt   DateTime?
  /// สร้างโดย
  createdBy    String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  fiscalYearRef FiscalYear?   @relation(fields: [fiscalYearId], references: [id])
  lines         JournalLine[]
  reversedBy    JournalEntry? @relation("JournalReversal", fields: [reversedById], references: [id])
  reversals     JournalEntry[] @relation("JournalReversal")

  @@unique([tenantId, entryNo])
  @@index([tenantId])
  @@index([propertyId])
  @@index([entryDate])
  @@index([fiscalYear, fiscalPeriod])
  @@index([sourceType, sourceId])
  @@index([status])
  @@map("journal_entries")
}

/// รายการในสมุดรายวัน (Journal Line)
/// แต่ละ JournalEntry ต้องมีอย่างน้อย 2 lines (1 debit + 1 credit)
model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  /// รหัสบัญชี
  accountId      String
  /// บรรทัดที่
  lineNo         Int
  /// คำอธิบายรายการบรรทัด
  description    String?      @db.VarChar(300)
  /// เดบิต (0 ถ้าเป็น credit side)
  debit          Decimal      @default(0.00) @db.Decimal(14, 2)
  /// เครดิต (0 ถ้าเป็น debit side)
  credit         Decimal      @default(0.00) @db.Decimal(14, 2)
  /// Cost Center (optional)
  costCenterId   String?
  /// อ้างอิงรายการย่อย
  subRef         String?      @db.VarChar(100)
  createdAt      DateTime     @default(now())

  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        AccountChart @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@index([costCenterId])
  @@map("journal_lines")
}

/// ยอดคงเหลือบัญชีแยกประเภท (Ledger Balance)
/// Summary per account per period — ใช้ generate งบการเงิน
model LedgerBalance {
  id             String       @id @default(uuid())
  tenantId       String
  propertyId     String
  accountId      String
  fiscalYearId   String?
  /// ปี
  fiscalYear     Int
  /// งวด (1-12)
  fiscalPeriod   Int
  /// ยอดยกมาต้นงวด
  openingBalance Decimal      @default(0.00) @db.Decimal(14, 2)
  /// รวม Debit ในงวด
  periodDebit    Decimal      @default(0.00) @db.Decimal(14, 2)
  /// รวม Credit ในงวด
  periodCredit   Decimal      @default(0.00) @db.Decimal(14, 2)
  /// ยอดยกไปปลายงวด
  closingBalance Decimal      @default(0.00) @db.Decimal(14, 2)
  /// จำนวนรายการในงวด
  txnCount       Int          @default(0)
  updatedAt      DateTime     @updatedAt

  account        AccountChart @relation(fields: [accountId], references: [id])
  fiscalYearRef  FiscalYear?  @relation(fields: [fiscalYearId], references: [id])

  @@unique([tenantId, propertyId, accountId, fiscalYear, fiscalPeriod])
  @@index([tenantId])
  @@index([propertyId])
  @@index([accountId])
  @@index([fiscalYear, fiscalPeriod])
  @@map("ledger_balances")
}

// ─── MODULE 2: ACCOUNTS RECEIVABLE ────────────────────────────────────────────
// ลูกหนี้การค้า, Guest Folio, ใบเสร็จรับเงิน

/// ใบแจ้งหนี้ลูกหนี้ (AR Invoice)
/// ใช้สำหรับ: ใบเสร็จแขก, City Ledger, มัดจำ, ใบลดหนี้
model ArInvoice {
  id              String          @id @default(uuid())
  tenantId        String
  propertyId      String
  /// เลขที่ใบแจ้งหนี้ เช่น "INV-2024-001234"
  invoiceNo       String          @db.VarChar(30)
  invoiceType     ArInvoiceType   @default(GUEST_BILL)
  /// แขก (ถ้ามี)
  guestId         String?
  /// การจอง (ถ้ามี)
  bookingId       String?
  /// Folio ที่เกี่ยวข้อง
  folioId         String?
  /// บริษัท/ตัวแทน (City Ledger)
  companyName     String?         @db.VarChar(200)
  companyTaxId    String?         @db.VarChar(20)
  companyAddress  String?         @db.Text
  /// วันที่ออกใบแจ้งหนี้
  issueDate       DateTime        @db.Date
  /// กำหนดชำระ
  dueDate         DateTime        @db.Date
  /// ก่อน VAT
  subtotal        Decimal         @default(0.00) @db.Decimal(12, 2)
  /// ส่วนลด
  discountAmount  Decimal         @default(0.00) @db.Decimal(12, 2)
  /// ฐานภาษี VAT
  taxableAmount   Decimal         @default(0.00) @db.Decimal(12, 2)
  /// VAT 7%
  vatAmount       Decimal         @default(0.00) @db.Decimal(12, 2)
  /// หัก ณ ที่จ่าย (ถ้ามี)
  whtAmount       Decimal         @default(0.00) @db.Decimal(12, 2)
  /// ยอดรวมสุทธิ
  totalAmount     Decimal         @default(0.00) @db.Decimal(12, 2)
  /// ยอดที่ชำระแล้ว
  paidAmount      Decimal         @default(0.00) @db.Decimal(12, 2)
  /// ยอดค้างชำระ
  balance         Decimal         @default(0.00) @db.Decimal(12, 2)
  status          ArInvoiceStatus @default(DRAFT)
  /// สกุลเงิน
  currency        String          @default("THB") @db.VarChar(3)
  exchangeRate    Decimal         @default(1.000000) @db.Decimal(12, 6)
  /// หมายเหตุ
  notes           String?         @db.Text
  /// GL posting แล้วหรือยัง
  isPosted        Boolean          @default(false)
  postedAt        DateTime?
  postedBy        String?
  issuedBy        String?
  issuedAt        DateTime?
  /// ยกเลิกโดย
  voidedBy        String?
  voidedAt        DateTime?
  voidReason      String?         @db.Text
  createdBy       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  guest       Guest?          @relation(fields: [guestId], references: [id])
  booking     Booking?        @relation(fields: [bookingId], references: [id])
  folio       GuestFolio?     @relation(fields: [folioId], references: [id])
  lines       ArInvoiceLine[]
  receipts    ArReceiptAllocation[]

  @@unique([tenantId, invoiceNo])
  @@index([tenantId])
  @@index([propertyId])
  @@index([guestId])
  @@index([bookingId])
  @@index([folioId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
  @@map("ar_invoices")
}

/// รายการในใบแจ้งหนี้ AR
model ArInvoiceLine {
  id           String        @id @default(uuid())
  invoiceId    String
  lineNo       Int
  /// คำอธิบายรายการ
  description  String        @db.VarChar(300)
  chargeType   FolioChargeType
  quantity     Decimal       @default(1.00) @db.Decimal(10, 3)
  unitPrice    Decimal       @default(0.00) @db.Decimal(12, 2)
  discountAmt  Decimal       @default(0.00) @db.Decimal(12, 2)
  /// ยอดก่อนภาษี
  netAmount    Decimal       @default(0.00) @db.Decimal(12, 2)
  vatRate      Decimal       @default(7.00) @db.Decimal(5, 2)
  vatAmount    Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount  Decimal       @default(0.00) @db.Decimal(12, 2)
  /// GL Account ที่ map รายได้ประเภทนี้
  accountId    String?
  costCenterId String?
  /// อ้างอิงรายการต้นทาง (folioChargeId, orderId ฯลฯ)
  sourceRef    String?       @db.VarChar(100)
  createdAt    DateTime      @default(now())

  invoice      ArInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  account      AccountChart? @relation(fields: [accountId], references: [id])

  @@index([invoiceId])
  @@index([accountId])
  @@map("ar_invoice_lines")
}

/// Guest Folio — บัญชีแขก (สะสม charge ระหว่าง Stay)
/// เปิดตอน Check-in, ปิดตอน Check-out
model GuestFolio {
  id           String      @id @default(uuid())
  tenantId     String
  propertyId   String
  /// เลขที่ Folio เช่น "FOLIO-2024-001234"
  folioNo      String      @db.VarChar(30)
  bookingId    String
  guestId      String
  roomId       String?
  /// วันที่ Check-in
  checkInDate  DateTime    @db.Date
  /// วันที่ Check-out (อาจยังไม่มีถ้ายังอยู่)
  checkOutDate DateTime?   @db.Date
  /// วันที่เปิด Folio
  openDate     DateTime    @default(now())
  status       FolioStatus @default(OPEN)
  /// ยอดรวม charge ทั้งหมด
  totalCharges Decimal     @default(0.00) @db.Decimal(12, 2)
  /// ยอดที่ชำระแล้ว
  totalPayments Decimal    @default(0.00) @db.Decimal(12, 2)
  /// ยอดคงเหลือ (+ = ค้างชำระ, - = เครดิต)
  balance      Decimal     @default(0.00) @db.Decimal(12, 2)
  /// ยอดมัดจำ
  depositAmount Decimal    @default(0.00) @db.Decimal(12, 2)
  /// สกุลเงิน
  currency     String      @default("THB") @db.VarChar(3)
  /// หมายเหตุ
  notes        String?     @db.Text
  closedBy     String?
  closedAt     DateTime?
  createdBy    String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  charges      FolioCharge[]
  payments     FolioPayment[]
  booking      Booking      @relation(fields: [bookingId], references: [id])
  guest        Guest        @relation(fields: [guestId], references: [id])
  arInvoices   ArInvoice[]

  @@unique([tenantId, folioNo])
  @@index([tenantId])
  @@index([propertyId])
  @@index([bookingId])
  @@index([guestId])
  @@index([status])
  @@map("guest_folios")
}

/// รายการ Charge ใน Folio (ค่าใช้จ่ายสะสมของแขก)
model FolioCharge {
  id            String          @id @default(uuid())
  tenantId      String
  propertyId    String
  folioId       String
  chargeDate    DateTime        @default(now())
  chargeType    FolioChargeType
  description   String          @db.VarChar(300)
  quantity      Decimal         @default(1.00) @db.Decimal(10, 3)
  unitPrice     Decimal         @default(0.00) @db.Decimal(12, 2)
  /// ยอดก่อน VAT
  netAmount     Decimal         @default(0.00) @db.Decimal(12, 2)
  vatRate       Decimal         @default(7.00) @db.Decimal(5, 2)
  vatAmount     Decimal         @default(0.00) @db.Decimal(12, 2)
  totalAmount   Decimal         @default(0.00) @db.Decimal(12, 2)
  /// GL Account สำหรับ posting
  accountId     String?
  costCenterId  String?
  /// Night Audit ที่ post รายการนี้
  nightAuditId  String?
  /// อ้างอิง source (orderId, bookingId ฯลฯ)
  sourceType    String?         @db.VarChar(50)
  sourceId      String?
  /// Night Audit ที่ post
  isAutoPosted  Boolean         @default(false)
  /// กลับรายการแล้วหรือยัง
  isReversed    Boolean         @default(false)
  status        FolioChargeStatus @default(POSTED)
  reversedById  String?
  reversedBy    String?
  reversedAt    DateTime?
  postedBy      String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  folio         GuestFolio      @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId])
  @@index([chargeDate])
  @@index([chargeType])
  @@index([sourceType, sourceId])
  @@index([nightAuditId])
  @@map("folio_charges")
}

/// รายการชำระเงินใน Folio
model FolioPayment {
  id            String            @id @default(uuid())
  tenantId      String
  propertyId    String
  folioId       String
  paymentDate   DateTime          @default(now())
  method        AccPaymentMethod
  amount        Decimal           @db.Decimal(12, 2)
  /// อ้างอิง (เลขที่บัตร last 4, เลขที่โอน ฯลฯ)
  reference     String?           @db.VarChar(100)
  /// ชื่อผู้ชำระ
  payerName     String?           @db.VarChar(200)
  /// หมายเหตุ
  notes         String?           @db.Text
  status        ArReceiptStatus   @default(CLEARED)
  isReversed    Boolean           @default(false)
  postedBy      String
  createdAt     DateTime          @default(now())

  folio         GuestFolio        @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId])
  @@index([paymentDate])
  @@map("folio_payments")
}

/// ใบเสร็จรับเงิน (AR Receipt)
model ArReceipt {
  id           String           @id @default(uuid())
  tenantId     String
  propertyId   String
  /// เลขที่ใบเสร็จ เช่น "RCV-2024-001234"
  receiptNo    String           @db.VarChar(30)
  /// วันที่รับชำระ
  receiptDate  DateTime         @db.Date
  guestId      String?
  status       ArReceiptStatus  @default(DRAFT)
  companyName  String?          @db.VarChar(200)
  companyTaxId String?          @db.VarChar(20)
  method       AccPaymentMethod
  /// ยอดรวมที่รับ
  totalAmount  Decimal          @db.Decimal(12, 2)
  /// อ้างอิงการชำระ
  reference    String?          @db.VarChar(100)
  /// หมายเหตุ
  notes        String?          @db.Text
  /// GL posting แล้วหรือยัง
  isPosted     Boolean          @default(false)
  postedAt     DateTime?
  voidedBy     String?
  voidedAt     DateTime?
  createdBy    String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  guest        Guest?           @relation(fields: [guestId], references: [id])
  allocations  ArReceiptAllocation[]

  @@unique([tenantId, receiptNo])
  @@index([tenantId])
  @@index([propertyId])
  @@index([receiptDate])
  @@index([guestId])
  @@map("ar_receipts")
}

/// การจัดสรรการรับชำระกับ Invoice
model ArReceiptAllocation {
  id          String    @id @default(uuid())
  tenantId    String
  receiptId   String
  invoiceId   String
  amount      Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())

  receipt     ArReceipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoice     ArInvoice  @relation(fields: [invoiceId], references: [id])

  @@unique([receiptId, invoiceId])
  @@index([receiptId])
  @@index([invoiceId])
  @@map("ar_receipt_allocations")
}

// ─── MODULE 3: ACCOUNTS PAYABLE ────────────────────────────────────────────────
// เจ้าหนี้การค้า, Supplier Invoice, การจ่ายชำระ

/// ใบแจ้งหนี้จาก Supplier (AP Invoice)
/// ต่อเนื่องจาก PurchaseOrder + GoodsReceive ที่มีอยู่แล้ว
model ApInvoice {
  id               String          @id @default(uuid())
  tenantId         String
  propertyId       String
  /// เลขที่ใบแจ้งหนี้ (ภายใน) เช่น "APINV-2024-001234"
  invoiceNo        String          @db.VarChar(30)
  /// เลขที่ใบแจ้งหนี้ของ Supplier
  supplierInvoiceNo String?        @db.VarChar(100)
  invoiceType      ApInvoiceType   @default(SUPPLIER_INVOICE)
  supplierId       String
  /// อ้างอิง Purchase Order
  purchaseOrderId  String?
  /// อ้างอิง Goods Receive
  goodsReceiveId   String?
  invoiceDate      DateTime        @db.Date
  dueDate          DateTime        @db.Date
  /// ยอดก่อน VAT
  subtotal         Decimal         @default(0.00) @db.Decimal(12, 2)
  /// ส่วนลด
  discountAmount   Decimal         @default(0.00) @db.Decimal(12, 2)
  /// ฐานภาษี VAT
  taxableAmount    Decimal         @default(0.00) @db.Decimal(12, 2)
  /// VAT 7%
  vatAmount        Decimal         @default(0.00) @db.Decimal(12, 2)
  /// หัก ณ ที่จ่าย
  whtAmount        Decimal         @default(0.00) @db.Decimal(12, 2)
  /// ยอดรวมสุทธิที่ต้องจ่าย
  totalAmount      Decimal         @default(0.00) @db.Decimal(12, 2)
  /// ยอดที่หัก WHT แล้ว (Code expects this)
  netPayable       Decimal         @default(0.00) @db.Decimal(12, 2)
  /// ยอดที่จ่ายแล้ว
  paidAmount       Decimal         @default(0.00) @db.Decimal(12, 2)
  /// ยอดค้างจ่าย
  balance          Decimal         @default(0.00) @db.Decimal(12, 2)
  status           ApInvoiceStatus @default(PENDING)
  currency         String          @default("THB") @db.VarChar(3)
  exchangeRate     Decimal         @default(1.000000) @db.Decimal(12, 6)
  paymentTerms     String?         @db.VarChar(100)
  notes            String?         @db.Text
  internalNotes    String?         @db.Text
  /// GL posting แล้วหรือยัง
  isPosted         Boolean         @default(false)
  postedAt         DateTime?
  approvedBy       String?
  approvedAt       DateTime?
  voidedBy         String?
  voidedAt         DateTime?
  voidReason       String?         @db.Text
  createdBy        String
  createdAt        DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  supplier     Supplier        @relation(fields: [supplierId], references: [id])
  lines        ApInvoiceLine[]
  payments     ApPaymentAllocation[]

  @@unique([tenantId, invoiceNo])
  @@index([tenantId])
  @@index([propertyId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([status])
  @@index([dueDate])
  @@map("ap_invoices")
}

/// รายการในใบแจ้งหนี้ AP
model ApInvoiceLine {
  id           String        @id @default(uuid())
  invoiceId    String
  lineNo       Int
  description  String        @db.VarChar(300)
  /// อ้างอิงสินค้า/บริการ
  itemId       String?
  quantity     Decimal       @default(1.00) @db.Decimal(10, 3)
  unitPrice    Decimal       @default(0.00) @db.Decimal(12, 2)
  discountAmt  Decimal       @default(0.00) @db.Decimal(12, 2)
  netAmount    Decimal       @default(0.00) @db.Decimal(12, 2)
  vatRate      Decimal       @default(7.00) @db.Decimal(5, 2)
  vatAmount    Decimal       @default(0.00) @db.Decimal(12, 2)
  whtRate      Decimal       @default(0.00) @db.Decimal(5, 2)
  whtAmount    Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount  Decimal       @default(0.00) @db.Decimal(12, 2)
  /// GL Account ที่ map ค่าใช้จ่ายประเภทนี้
  accountId    String?
  costCenterId String?
  createdAt    DateTime      @default(now())

  invoice      ApInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  account      AccountChart? @relation(fields: [accountId], references: [id])

  @@index([invoiceId])
  @@index([accountId])
  @@map("ap_invoice_lines")
}

/// การจ่ายชำระเจ้าหนี้ (AP Payment)
model ApPayment {
  id            String           @id @default(uuid())
  tenantId      String
  propertyId    String
  /// เลขที่ใบสำคัญจ่าย เช่น "PV-2024-001234"
  paymentNo     String           @db.VarChar(30)
  paymentDate   DateTime         @db.Date
  supplierId    String
  method        AccPaymentMethod
  /// ยอดรวมที่จ่าย (ก่อนหัก WHT)
  grossAmount   Decimal          @db.Decimal(12, 2)
  /// หัก ณ ที่จ่าย
  whtAmount     Decimal          @default(0.00) @db.Decimal(12, 2)
  /// ยอดสุทธิที่จ่ายจริง
  netAmount     Decimal          @db.Decimal(12, 2)
  /// บัญชีธนาคารที่จ่าย
  bankAccountId String?
  /// อ้างอิง (เลขที่โอน, เช็คเลขที่ ฯลฯ)
  reference     String?          @db.VarChar(100)
  notes         String?          @db.Text
  /// GL posting แล้วหรือยัง
  isPosted      Boolean          @default(false)
  postedAt      DateTime?
  /// สถานะ: DRAFT, PENDING, APPROVED, PAID, VOID
  status        String           @default("DRAFT") @db.VarChar(20)
  approvedBy    String?
  approvedAt    DateTime?
  voidedBy      String?
  voidedAt      DateTime?
  createdBy     String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  supplier      Supplier         @relation(fields: [supplierId], references: [id])
  allocations   ApPaymentAllocation[]
  whtCerts      WhtCertificate[]

  @@unique([tenantId, paymentNo])
  @@index([tenantId])
  @@index([propertyId])
  @@index([supplierId])
  @@index([paymentDate])
  @@index([status])
  @@map("ap_payments")
}

/// การจัดสรรการจ่ายชำระกับ AP Invoice
model ApPaymentAllocation {
  id          String    @id @default(uuid())
  tenantId    String
  paymentId   String
  invoiceId   String
  amount      Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())

  payment     ApPayment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice     ApInvoice  @relation(fields: [invoiceId], references: [id])

  @@unique([paymentId, invoiceId])
  @@index([paymentId])
  @@index([invoiceId])
  @@map("ap_payment_allocations")
}

// ─── MODULE 4: TAX MANAGEMENT ──────────────────────────────────────────────────
// อัตราภาษี, ใบหัก ณ ที่จ่าย, การยื่นแบบภาษี (มาตรฐานไทย)

/// อัตราภาษี (Tax Rate Configuration)
model TaxRate {
  id          String    @id @default(uuid())
  tenantId    String
  /// ชื่อ เช่น "VAT 7%", "WHT 3% (บริการ)"
  name        String    @db.VarChar(100)
  /// รหัส เช่น "VAT", "WHT_SERVICE_3"
  code        String    @db.VarChar(30)
  type        TaxType
  /// อัตราภาษี (%)
  rate        Decimal   @db.Decimal(5, 2)
  /// GL Account สำหรับภาษีที่ต้องนำส่ง
  taxPayableAccountId   String?
  /// GL Account สำหรับภาษีซื้อ
  taxInputAccountId     String?
  /// ประเภทเงินได้ WHT (ถ้าเป็น WHT)
  whtIncomeType         WhtIncomeType?
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  taxPayableAccount  AccountChart? @relation(fields: [taxPayableAccountId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
  @@map("tax_rates")
}

/// ใบหัก ณ ที่จ่าย (WHT Certificate)
/// ออกให้ Supplier เมื่อมีการหักภาษี ณ ที่จ่าย
model WhtCertificate {
  id            String        @id @default(uuid())
  tenantId      String
  propertyId    String
  /// เลขที่ใบหัก ณ ที่จ่าย เช่น "WHT-2024-001234"
  certNo        String        @db.VarChar(30)
  supplierId    String
  /// AP Payment ที่เกี่ยวข้อง
  apPaymentId   String?
  /// วันที่จ่าย
  paymentDate   DateTime      @db.Date
  /// ประเภทเงินได้
  incomeType    WhtIncomeType
  /// ยอดเงินได้
  incomeAmount  Decimal       @db.Decimal(12, 2)
  /// อัตรา WHT (%)
  whtRate       Decimal       @db.Decimal(5, 2)
  /// ยอดภาษีที่หัก
  whtAmount     Decimal       @db.Decimal(12, 2)
  status        WhtCertStatus @default(DRAFT)
  /// ผู้รับเงิน (ชื่อ/ที่อยู่ ณ วันที่ออก)
  payeeName     String        @db.VarChar(200)
  payeeTaxId    String?       @db.VarChar(20)
  payeeAddress  String?       @db.Text
  /// ผู้ออกใบหัก (บริษัทโรงแรม)
  issuerName    String?       @db.VarChar(200)
  issuerTaxId   String?       @db.VarChar(20)
  /// สร้างโดย
  issuedBy      String
  createdBy     String?
  issuedAt      DateTime?
  voidedBy      String?
  voidedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  apPayment     ApPayment?    @relation(fields: [apPaymentId], references: [id])
  supplier      Supplier      @relation(fields: [supplierId], references: [id])

  @@unique([tenantId, certNo])
  @@index([tenantId])
  @@index([propertyId])
  @@index([supplierId])
  @@index([paymentDate])
  @@index([status])
  @@map("wht_certificates")
}

/// แบบยื่นภาษี (Tax Filing)
/// รวบรวมรายการเพื่อยื่น ภ.พ.30, ภ.ง.ด.1/3/53
model TaxFiling {
  id           String          @id @default(uuid())
  tenantId     String
  propertyId   String
  filingType   TaxFilingType
  /// งวดที่ยื่น เช่น "2024-01"
  period       String          @db.VarChar(10)
  /// ปีภาษี
  taxYear      Int
  /// เดือนภาษี
  taxMonth     Int
  /// ยอดรวมรายได้/ฐานภาษี
  totalBase    Decimal         @default(0.00) @db.Decimal(14, 2)
  /// ยอดภาษี
  totalTax     Decimal         @default(0.00) @db.Decimal(14, 2)
  /// ยอดที่ชำระ
  paidAmount   Decimal         @default(0.00) @db.Decimal(14, 2)
  status       TaxFilingStatus @default(DRAFT)
  /// วันครบกำหนดยื่น
  dueDate      DateTime        @db.Date
  /// วันที่ยื่นจริง
  filedAt      DateTime?
  /// ยื่นโดย
  filedBy      String?
  /// วันที่ชำระ
  paidAt       DateTime?
  /// ชำระโดย
  paidBy       String?
  /// สร้างโดย
  createdBy    String?
  /// เลขที่อ้างอิงการยื่น
  filingRef    String?         @db.VarChar(100)
  notes        String?         @db.Text
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  lines        TaxFilingLine[]

  @@unique([tenantId, propertyId, filingType, period])
  @@index([tenantId])
  @@index([propertyId])
  @@index([filingType])
  @@index([period])
  @@index([status])
  @@map("tax_filings")
}

/// รายการในแบบยื่นภาษี
model TaxFilingLine {
  id          String    @id @default(uuid())
  filingId    String
  lineNo      Int
  description String    @db.VarChar(300)
  /// อ้างอิงเอกสาร (WHT cert no, invoice no ฯลฯ)
  docRef      String?   @db.VarChar(100)
  baseAmount  Decimal   @default(0.00) @db.Decimal(12, 2)
  taxRate     Decimal   @default(0.00) @db.Decimal(5, 2)
  taxAmount   Decimal   @default(0.00) @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())

  filing      TaxFiling @relation(fields: [filingId], references: [id], onDelete: Cascade)

  @@index([filingId])
  @@map("tax_filing_lines")
}

// ─── MODULE 5: NIGHT AUDIT ─────────────────────────────────────────────────────
// Night Audit ประจำวัน — auto-post ค่าห้อง, reconcile รายได้

/// Night Audit รายวัน
/// ทำทุกคืนเพื่อ: post ค่าห้อง, สรุปรายได้, ปิดงวดวัน
model NightAudit {
  id                String           @id @default(uuid())
  tenantId          String
  propertyId        String
  /// วันที่ทำ Night Audit
  auditDate         DateTime         @db.Date
  status            NightAuditStatus @default(OPEN)

  // ── สรุปรายได้ ──
  /// รายได้ค่าห้อง
  roomRevenue       Decimal          @default(0.00) @db.Decimal(12, 2)
  /// รายได้ F&B
  fbRevenue         Decimal          @default(0.00) @db.Decimal(12, 2)
  /// รายได้อื่นๆ
  otherRevenue      Decimal          @default(0.00) @db.Decimal(12, 2)
  /// รายได้รวม
  totalRevenue      Decimal          @default(0.00) @db.Decimal(12, 2)

  // ── สรุป Folio ──
  /// ยอด Charge รวม
  totalCharges      Decimal          @default(0.00) @db.Decimal(12, 2)
  /// ยอดรับชำระรวม
  totalPayments     Decimal          @default(0.00) @db.Decimal(12, 2)
  /// ยอดคงเหลือ
  totalBalance      Decimal          @default(0.00) @db.Decimal(12, 2)

  // ── สถิติห้องพัก ──
  totalRooms        Int              @default(0)
  occupiedRooms     Int              @default(0)
  /// เปอร์เซ็นต์ Occupancy
  occupancyRate     Decimal          @default(0.00) @db.Decimal(5, 2)
  /// Average Daily Rate
  adr               Decimal          @default(0.00) @db.Decimal(10, 2)
  /// Revenue Per Available Room
  revPAR            Decimal          @default(0.00) @db.Decimal(10, 2)
  /// จำนวนแขก check-in วันนี้
  checkInsCount     Int              @default(0)
  /// จำนวนแขก check-out วันนี้
  checkOutsCount    Int              @default(0)

  startedBy         String?
  startedAt         DateTime?
  completedBy       String?
  completedAt       DateTime?
  /// Journal Entry ที่สร้างจาก Night Audit
  journalEntryId    String?
  notes             String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  charges           NightAuditCharge[]

  @@unique([tenantId, propertyId, auditDate])
  @@index([tenantId])
  @@index([propertyId])
  @@index([auditDate])
  @@index([status])
  @@map("night_audits")
}

/// รายการ Charge ที่ Night Audit สร้าง (ส่วนใหญ่คือค่าห้องพัก)
model NightAuditCharge {
  id            String    @id @default(uuid())
  nightAuditId  String
  folioId       String
  bookingId     String
  roomId        String?
  chargeType    FolioChargeType
  description   String    @db.VarChar(300)
  amount        Decimal   @db.Decimal(12, 2)
  vatAmount     Decimal   @default(0.00) @db.Decimal(12, 2)
  totalAmount   Decimal   @db.Decimal(12, 2)
  /// post ลง folio สำเร็จหรือยัง
  isPosted      Boolean   @default(false)
  postedAt      DateTime?
  createdAt     DateTime  @default(now())

  nightAudit    NightAudit @relation(fields: [nightAuditId], references: [id], onDelete: Cascade)

  @@index([nightAuditId])
  @@index([folioId])
  @@index([bookingId])
  @@map("night_audit_charges")
}

// ─── MODULE 6: CASH MANAGEMENT ─────────────────────────────────────────────────
// เงินสด, ลิ้นชัก, กระทบยอดธนาคาร

/// ลิ้นชักเงินสด (Cash Drawer)
/// แต่ละแผนก/กะมีลิ้นชักของตัวเอง
model CashDrawer {
  id              String           @id @default(uuid())
  tenantId        String
  propertyId      String
  /// ชื่อ เช่น "แผนกต้อนรับ - กะเช้า"
  name            String           @db.VarChar(100)
  /// รหัสลิ้นชัก
  code            String           @db.VarChar(20)
  /// ยอดเงินเปิดกะ
  openingBalance  Decimal          @default(0.00) @db.Decimal(12, 2)
  /// ยอดเงินปัจจุบัน
  currentBalance  Decimal          @default(0.00) @db.Decimal(12, 2)
  status          CashDrawerStatus @default(OPEN)
  /// เปิดกะโดย
  openedBy        String?
  openedAt        DateTime?
  /// ปิดกะโดย
  closedBy        String?
  closedAt        DateTime?
  /// ยอดเงินที่นับได้จริงตอนปิดกะ
  countedAmount   Decimal?         @db.Decimal(12, 2)
  /// ผลต่าง (นับได้ - ระบบ)
  variance        Decimal?         @db.Decimal(12, 2)
  notes           String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  transactions    CashTransaction[]

  @@unique([tenantId, propertyId, code])
  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
  @@map("cash_drawers")
}

/// รายการเงินสด (Cash Transaction)
model CashTransaction {
  id          String       @id @default(uuid())
  drawerId    String
  tenantId    String
  propertyId  String
  txnDate     DateTime     @default(now())
  txnType     CashTxnType
  description String       @db.VarChar(300)
  amount      Decimal      @db.Decimal(12, 2)
  /// ยอดหลังรายการ
  balance     Decimal      @db.Decimal(12, 2)
  /// ลิ้นชักปลายทาง (กรณี TRANSFER)
  toDrawerId  String?
  /// อ้างอิงเอกสาร (folioId, invoiceNo ฯลฯ)
  sourceType  String?      @db.VarChar(50)
  sourceId    String?
  reference   String?      @db.VarChar(100)
  createdBy   String
  createdAt   DateTime     @default(now())

  drawer      CashDrawer   @relation(fields: [drawerId], references: [id])

  @@index([drawerId])
  @@index([tenantId])
  @@index([txnDate])
  @@index([sourceType, sourceId])
  @@map("cash_transactions")
}

/// กระทบยอดธนาคาร (Bank Reconciliation)
/// กระทบยอด Statement จากธนาคาร vs ยอดในระบบ
model BankReconciliation {
  id                String          @id @default(uuid())
  tenantId          String
  propertyId        String
  /// บัญชีธนาคาร (FK ไปหา BankAccount ที่มีอยู่แล้ว)
  bankAccountId     String
  /// งวด เช่น "2024-01"
  period            String          @db.VarChar(10)
  /// วันที่ Statement
  statementDate     DateTime        @db.Date
  /// ยอด Statement จากธนาคาร
  statementBalance  Decimal         @db.Decimal(14, 2)
  /// ยอดในสมุดบัญชี
  bookBalance       Decimal         @db.Decimal(14, 2)
  /// ผลต่าง
  variance          Decimal         @default(0.00) @db.Decimal(14, 2)
  status            ReconcileStatus @default(OPEN)
  approvedBy        String?
  approvedAt        DateTime?
  notes             String?         @db.Text
  createdBy         String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  lines             BankReconLine[]

  @@unique([tenantId, propertyId, bankAccountId, period])
  @@index([tenantId])
  @@index([propertyId])
  @@index([bankAccountId])
  @@index([status])
  @@map("bank_reconciliations")
}

/// รายการกระทบยอดธนาคาร
model BankReconLine {
  id              String             @id @default(uuid())
  reconId         String
  /// ประเภท: DEPOSIT (ฝาก), WITHDRAWAL (ถอน), TRANSFER
  txnType         String             @db.VarChar(20)
  /// วันที่รายการ
  txnDate         DateTime           @db.Date
  description     String             @db.VarChar(300)
  /// ยอดจาก Statement
  statementAmount Decimal            @default(0.00) @db.Decimal(12, 2)
  /// ยอดในสมุดบัญชี
  bookAmount      Decimal            @default(0.00) @db.Decimal(12, 2)
  /// กระทบยอดแล้ว
  isMatched       Boolean            @default(false)
  matchedAt       DateTime?
  /// อ้างอิงรายการในระบบ (JournalEntryId, PaymentId ฯลฯ)
  bookRef         String?            @db.VarChar(100)
  /// อ้างอิง Statement (เลขที่รายการจากธนาคาร)
  statementRef    String?            @db.VarChar(100)
  notes           String?            @db.Text
  createdAt       DateTime           @default(now())

  reconciliation  BankReconciliation @relation(fields: [reconId], references: [id], onDelete: Cascade)

  @@index([reconId])
  @@index([txnDate])
  @@index([isMatched])
  @@map("bank_recon_lines")
}

// ─── MODULE 7: FIXED ASSETS ────────────────────────────────────────────────────
// สินทรัพย์ถาวร, ค่าเสื่อมราคา

/// สินทรัพย์ถาวร (Fixed Asset Register)
model FixedAsset {
  id                  String              @id @default(uuid())
  tenantId            String
  propertyId          String
  /// รหัสสินทรัพย์ เช่น "FA-2024-001234"
  assetCode           String              @db.VarChar(30)
  name                String              @db.VarChar(200)
  description         String?             @db.Text
  category            FixedAssetCategory
  /// แผนก/Cost Center ที่ใช้สินทรัพย์
  costCenterId        String?
  /// GL Account สินทรัพย์
  assetAccountId      String?
  /// GL Account ค่าเสื่อมสะสม
  accumDeprecAccountId String?
  /// GL Account ค่าเสื่อมราคา (Expense)
  deprecExpenseAccountId String?
  /// วันที่ซื้อ
  purchaseDate        DateTime            @db.Date
  /// ราคาซื้อ
  purchaseCost        Decimal             @db.Decimal(14, 2)
  /// ค่าใช้จ่ายในการได้มาเพิ่มเติม
  acquisitionCost     Decimal             @default(0.00) @db.Decimal(14, 2)
  /// มูลค่าซาก (Residual Value)
  residualValue       Decimal             @default(0.00) @db.Decimal(14, 2)
  /// อายุการใช้งาน (ปี)
  usefulLifeYears     Int
  depreciationMethod  DepreciationMethod  @default(STRAIGHT_LINE)
  /// อัตราค่าเสื่อม (%) สำหรับ Declining Balance
  depreciationRate    Decimal?            @db.Decimal(5, 2)
  /// มูลค่าสะสมค่าเสื่อม
  accumulatedDepreciation Decimal         @default(0.00) @db.Decimal(14, 2)
  /// มูลค่าตามบัญชี (Book Value)
  bookValue           Decimal             @db.Decimal(14, 2)
  status              AssetStatus         @default(ACTIVE)
  /// ที่ตั้ง/ห้อง
  location            String?             @db.VarChar(200)
  /// Serial Number / ทะเบียน
  serialNo            String?             @db.VarChar(100)
  /// ผู้ดูแล
  responsiblePerson   String?
  /// อ้างอิง PO ที่ซื้อ
  purchaseOrderId     String?
  /// วันที่จำหน่าย
  disposalDate        DateTime?           @db.Date
  disposalAmount      Decimal?            @db.Decimal(14, 2)
  disposedBy          String?
  disposalReason      String?             @db.Text
  notes               String?             @db.Text
  createdBy           String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  depreciations       AssetDepreciation[]

  @@unique([tenantId, assetCode])
  @@index([tenantId])
  @@index([propertyId])
  @@index([category])
  @@index([status])
  @@index([costCenterId])
  @@map("fixed_assets")
}

/// ค่าเสื่อมราคา (Asset Depreciation Schedule)
/// บันทึกค่าเสื่อมทุกงวด (รายเดือน)
model AssetDepreciation {
  id                    String     @id @default(uuid())
  assetId               String
  tenantId              String
  /// งวด เช่น "2024-01"
  period                String     @db.VarChar(10)
  fiscalYear            Int
  fiscalPeriod          Int
  /// วันที่บันทึกค่าเสื่อม
  depreciationDate      DateTime   @db.Date
  /// ค่าเสื่อมงวดนี้
  depreciationAmount    Decimal    @db.Decimal(14, 2)
  /// ค่าเสื่อมสะสมหลังงวดนี้
  accumulatedAmount     Decimal    @db.Decimal(14, 2)
  /// มูลค่าตามบัญชีหลังงวดนี้
  bookValue             Decimal    @db.Decimal(14, 2)
  /// Journal Entry ที่บันทึก
  journalEntryId        String?
  /// บันทึกแล้วหรือยัง
  isPosted              Boolean    @default(false)
  postedAt              DateTime?
  postedBy              String?
  createdAt             DateTime   @default(now())

  asset                 FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, period])
  @@index([assetId])
  @@index([tenantId])
  @@index([period])
  @@index([isPosted])
  @@map("asset_depreciations")
}

