# ┌──────────────────────────────────────────────────────────────────────────┐
# │  StaySync API — Environment Template                                     │
# │                                                                          │
# │  ⚠️  CRITICAL — DO NOT COMMIT REAL VALUES TO THIS FILE                   │
# │                                                                          │
# │  ทุก placeholder ต่อไปนี้ต้องถูกแทนที่ใน .env ของแต่ละ environment        │
# │  ห้ามคัดลอกค่าเหล่านี้ไปใช้ตรงๆ — ระบบจะ refuse to start                 │
# │  (ดู `src/config/env.validation.ts`)                                     │
# │                                                                          │
# │  ก่อน commit ทุกครั้ง: รัน `gitleaks detect --no-banner`                 │
# └──────────────────────────────────────────────────────────────────────────┘

# ============================================
# DATABASE (MySQL)
# ============================================
DB_HOST=localhost
DB_PORT=9012
DB_USERNAME=root
DB_PASSWORD=__REPLACE_WITH_STRONG_DB_PASSWORD__
DB_DATABASE=hotel_services_db

# ============================================
# PRISMA
# ============================================
# Format: mysql://username:password@host:port/database
DATABASE_URL=mysql://USERNAME:PASSWORD@localhost:3306/hotel_services_db

# ============================================
# JWT / AUTHENTICATION
# ============================================
# JWT secret key — generate ด้วย: openssl rand -hex 64
# ต้องมีความยาว 128 hex chars (64 bytes)
# ⚠️ ค่าตัวอย่างต่อไปนี้ถูก reject โดย env validation — ห้ามใช้
JWT_SECRET=__GENERATE_WITH__openssl_rand_hex_64__MUST_BE_128_CHARS__
# JWT token expiration time
JWT_EXPIRES_IN=24h

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=9011
APP_NAME=Hotel Services
FRONTEND_URL=http://localhost:9010

# ============================================
# CORS
# ============================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:2000,http://localhost:9010,http://localhost:9011

# ============================================
# REDIS
# ============================================
# Redis configuration for Bull job queue and caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# SMTP / EMAIL
# ============================================
# SMTP server configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=__REPLACE_WITH_REAL_SMTP_USER__
SMTP_PASS=__REPLACE_WITH_GMAIL_APP_PASSWORD__
SMTP_SECURE=false
# Sender information for emails
SMTP_FROM_EMAIL=noreply@staysync.com
SMTP_FROM_NAME=StaySync Hotel Services

# ============================================
# FIREBASE (PUSH NOTIFICATIONS)
# ============================================
# Firebase Admin SDK credentials
# Download fresh service account JSON from Firebase Console after rotation
FIREBASE_PROJECT_ID=__REPLACE_WITH_PROJECT_ID__
FIREBASE_CLIENT_EMAIL=__REPLACE_WITH_SERVICE_ACCOUNT_EMAIL__
# Private key with escaped newlines (\n will be converted to actual newlines)
# ⚠️ ห้าม commit ค่าจริงเด็ดขาด — ใช้ FIREBASE_PRIVATE_KEY_JSON_PATH แทนถ้าเป็นไปได้
FIREBASE_PRIVATE_KEY=__REPLACE_WITH_PEM_BLOCK_FROM_FIREBASE_CONSOLE__
# Recommended: store the JSON file outside the repo and set the path here
# FIREBASE_PRIVATE_KEY_JSON_PATH=/path/to/firebase-key.json

# ============================================
# LINE NOTIFY
# ============================================
# LINE Notify OAuth credentials for user notifications
LINE_NOTIFY_CLIENT_ID=__REPLACE_WITH_LINE_NOTIFY_CLIENT_ID__
LINE_NOTIFY_CLIENT_SECRET=__REPLACE_WITH_LINE_NOTIFY_CLIENT_SECRET__
# Callback URL for LINE Notify OAuth redirect
LINE_NOTIFY_CALLBACK_URL=http://localhost:9011/api/v1/line-notify/callback

# ============================================
# PROMPTPAY
# ============================================
# PromptPay payment configuration
PROMPTPAY_ID=__REPLACE_WITH_10_DIGIT_PHONE_OR_13_DIGIT_TAX_ID__
MERCHANT_NAME=StaySync
MERCHANT_CITY=Bangkok

# ============================================
# 2FA (SPEAKEASY)
# ============================================
# Two-factor authentication settings are configured via Speakeasy library
# No additional env vars required, but APP_NAME is used for TOTP label

# ============================================
# FILE UPLOAD
# ============================================
# Future: Add S3/Cloud storage configuration when file upload feature is implemented
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET=staysync-uploads
# MAX_FILE_SIZE=5242880  # 5MB in bytes

# ============================================
# API URLS
# ============================================
# External API endpoints
NEXT_PUBLIC_API_URL=http://localhost:9011/api

# ── PDPA Encryption (S1-04) ───────────────────────────────────
# AES-256-GCM key สำหรับเข้ารหัสข้อมูล sensitive (nationalId, passport, bankAccount ฯลฯ)
# ต้องเป็น hex string ยาว 64 ตัวอักษร (= 32 bytes)
# สร้างด้วย: openssl rand -hex 32
# ⚠️  CRITICAL: ห้าม commit ค่าจริงลง git เด็ดขาด
# ⚠️  ห้าม rotate key นี้บน production โดยไม่มี re-encryption migration plan
ENCRYPTION_KEY=__GENERATE_WITH__openssl_rand_hex_32__MUST_BE_64_CHARS__

# ── Database Seeder Passwords (S4-01 security fix) ────────────
# รหัสผ่านสำหรับ demo accounts ที่ seeder สร้าง — ห้ามใช้ค่า default บน staging/production
# สร้างค่าใหม่ทุกครั้งก่อนรัน seed บน environment จริง
# ⚠️  ห้าม commit ค่าจริงลง git
SEED_DEFAULT_PASSWORD=__REPLACE_BEFORE_RUNNING_SEED__
SEED_STAFF_PASSWORD=__REPLACE_BEFORE_RUNNING_SEED__
