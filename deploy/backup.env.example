# คัดลอกเป็น /etc/staysync/backup.env แล้วใส่ค่าจริง (chmod 600)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=staysync
DB_PASSWORD=__REPLACE__
DB_DATABASE=hotel_services_db

# Cloudflare R2 สำหรับเก็บ backup
R2_BUCKET=staysync-backups
R2_ENDPOINT=https://__ACCOUNT_ID__.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=__R2_ACCESS_KEY__
AWS_SECRET_ACCESS_KEY=__R2_SECRET_KEY__
AWS_DEFAULT_REGION=auto

RETENTION_DAYS=30
