# คัดลอกเป็น ~/apps/.env แล้วใส่ค่าจริง — ห้าม commit
# ─── Database ───
DB_ROOT_PASSWORD=__STRONG_ROOT_PW__
DB_USERNAME=staysync
DB_PASSWORD=__STRONG_DB_PW__
DB_DATABASE=hotel_services_db

# ─── Redis ───
REDIS_PASSWORD=__STRONG_REDIS_PW__

# ─── Auth / Crypto ───
# openssl rand -hex 64
JWT_SECRET=__128_HEX_CHARS__
JWT_EXPIRES_IN=24h
# openssl rand -hex 32
ENCRYPTION_KEY=__64_HEX_CHARS__

# ─── URLs (โดเมนจริง) ───
FRONTEND_URL=https://app.example.com
ALLOWED_ORIGINS=https://app.example.com
APP_BASE_URL=https://api.example.com
# ใส่ให้ตรงกับที่ frontend คาดหวัง (เช็ค lib/api ของ frontend ว่าต่อ /api/v1 เองไหม)
NEXT_PUBLIC_API_URL=https://api.example.com

# ─── File storage: Cloudflare R2 ───
S3_BUCKET=staysync-uploads
S3_PUBLIC_URL=https://cdn.example.com
S3_ENDPOINT=https://__ACCOUNT_ID__.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=__R2_ACCESS_KEY__
S3_SECRET_ACCESS_KEY=__R2_SECRET_KEY__
